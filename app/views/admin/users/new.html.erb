<div class="page-heading"><div><p class="eyebrow">ADMINISTRAÇÃO</p><h1>Convidar usuário</h1><p class="muted">O usuário receberá um e-mail para definir a própria senha.</p></div></div>
<%= form_with model: [:admin, @user], class: "panel stack-form narrow-panel" do |form| %><% if @user.errors.any? %><div class="form-errors"><%= @user.errors.full_messages.to_sentence %></div><% end %><%= form.label :name, "Nome" %><%= form.text_field :name, required: true %><%= form.label :email_address, "E-mail" %><%= form.email_field :email_address, required: true %><%= form.label :role, "Perfil" %><%= form.select :role, [["Membro", "member"], ["Administrador", "admin"]] %><%= form.hidden_field :active, value: true %><div class="form-actions"><%= link_to "Cancelar", admin_users_path, class: "button secondary" %><%= form.submit "Enviar convite", class: "button primary" %></div><% end %>
