<div class="page-heading"><div><p class="eyebrow">ADMINISTRAÇÃO</p><h1>Usuários</h1><p class="muted">Controle quem pode consultar e administrar o acervo.</p></div><%= link_to "Convidar usuário", new_admin_user_path, class: "button primary" %></div>
<div class="table-card"><table><thead><tr><th>Usuário</th><th>Perfil</th><th>Último acesso</th><th>Status</th><th></th></tr></thead><tbody><% @users.each do |user| %><tr><td><strong><%= user.name %></strong><small><%= user.email_address %></small></td><td><%= user.admin? ? "Administrador" : "Membro" %></td><td><%= user.last_sign_in_at ? l(user.last_sign_in_at, format: :short) : "Nunca" %></td><td><span class="status <%= user.active? ? "ok" : "off" %>"><%= user.active? ? "Ativo" : "Inativo" %></span></td><td><%= form_with model: [:admin, user], method: :patch, class: "inline-form" do |form| %><%= form.hidden_field :role, value: user.role %><%= form.hidden_field :active, value: !user.active? %><%= form.submit(user.active? ? "Desativar" : "Ativar", class: "text-action") %><% end %></td></tr><% end %></tbody></table></div>
