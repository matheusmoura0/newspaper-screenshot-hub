<div class="page-heading"><div><p class="eyebrow">JORNAL MONITORADO</p><h1><%= @newspaper.name %></h1><p class="muted"><%= @newspaper.homepage_url %></p></div><%= link_to "Editar", edit_admin_newspaper_path(@newspaper), class: "button primary" %></div>
<div class="detail-grid panel"><div><span>Status</span><strong><%= @newspaper.active? ? "Ativo" : "Pausado" %></strong></div><div><span>Horário</span><strong><%= @newspaper.capture_time.strftime("%H:%M") %></strong></div><div><span>Fuso</span><strong><%= @newspaper.time_zone %></strong></div><div><span>Formatos</span><strong><%= [@newspaper.desktop_enabled? && "Desktop", @newspaper.mobile_enabled? && "Mobile"].compact.join(" + ") %></strong></div></div>
