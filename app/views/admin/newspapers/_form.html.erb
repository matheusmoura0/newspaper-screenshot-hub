<%= form_with model: [:admin, newspaper], class: "panel stack-form" do |form| %>
  <% if newspaper.errors.any? %><div class="form-errors"><strong>Revise os campos:</strong><ul><% newspaper.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <div class="form-grid"><div><%= form.label :name, "Nome" %><%= form.text_field :name, required: true %></div><div><%= form.label :slug, "Identificador" %><%= form.text_field :slug, placeholder: "gerado automaticamente" %></div><div class="full"><%= form.label :homepage_url, "URL da página" %><%= form.url_field :homepage_url, required: true, placeholder: "https://..." %></div><div><%= form.label :category, "Categoria" %><%= form.text_field :category, placeholder: "Nacional, regional..." %></div><div><%= form.label :country, "País" %><%= form.text_field :country %></div><div><%= form.label :time_zone, "Fuso horário" %><%= form.select :time_zone, ActiveSupport::TimeZone.all.map { |zone| [zone.to_s, zone.tzinfo.name] } %></div><div><%= form.label :capture_time, "Horário de captura" %><%= form.time_field :capture_time %></div></div>
  <fieldset><legend>Formatos</legend><label class="check"><%= form.check_box :desktop_enabled %> Desktop</label><label class="check"><%= form.check_box :mobile_enabled %> Mobile</label><label class="check"><%= form.check_box :active %> Monitoramento ativo</label></fieldset>
  <div class="form-actions"><%= link_to "Cancelar", admin_newspapers_path, class: "button secondary" %><%= form.submit "Salvar jornal", class: "button primary" %></div>
<% end %>
