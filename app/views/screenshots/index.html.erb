<div class="page-heading"><div><p class="eyebrow">ACERVO DIÁRIO</p><h1>Capturas de <%= l @date, format: :long %></h1></div></div>
<%= form_with url: screenshots_path, method: :get, class: "filter-bar" do |form| %><%= form.date_field :date, value: @date %><%= form.collection_select :newspaper_id, @newspapers, :id, :name, { include_blank: "Todos os jornais", selected: params[:newspaper_id] } %><%= form.select :viewport, [["Todos os formatos", ""], ["Desktop", "desktop"], ["Mobile", "mobile"]], selected: params[:viewport] %><%= form.submit "Filtrar", class: "button primary" %><% end %>
<div class="gallery-grid"><% @screenshots.each do |screenshot| %><%= link_to screenshot_path(screenshot), class: "capture-card" do %><div class="capture-image"><%= image_tag screenshot.image.variant(resize_to_limit: [640, 800]) if screenshot.image.attached? %></div><div class="capture-meta"><strong><%= screenshot.newspaper.name %></strong><span><%= screenshot.viewport.capitalize %> · <%= screenshot.captured_at&.strftime("%H:%M") %></span></div><% end %><% end %><% if @screenshots.empty? %><div class="empty-state"><strong>Nenhuma captura nesta data</strong><p>Escolha outro dia ou aguarde a próxima execução.</p></div><% end %></div>
