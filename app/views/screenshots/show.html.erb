<div class="page-heading"><div><p class="eyebrow"><%= @screenshot.viewport.upcase %></p><h1><%= @screenshot.newspaper.name %></h1><p class="muted"><%= l @screenshot.captured_on, format: :long %> · <%= @screenshot.captured_at&.strftime("%H:%M") %></p></div><%= link_to "Voltar ao acervo", screenshots_path(date: @screenshot.captured_on), class: "button secondary" %></div><div class="screenshot-view"><%= image_tag @screenshot.image if @screenshot.image.attached? %></div>
